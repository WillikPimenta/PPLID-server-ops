# Copie para backend/.env e ajuste por ambiente
# MAIN: POSTGRES_DB=pplid_main, frontend :5173, backend :8000
# DEV:  POSTGRES_DB=pplid_dev,  frontend :5174, backend :8001
# HOM:  POSTGRES_DB=pplid_hom,  frontend :5175, backend :8002
# Substitua 10.97.198.186 pelo IPv4 LAN do servidor

SECRET_KEY=dev-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,10.97.198.186

POSTGRES_DB=pplid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://10.97.198.186:5173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://monitoramento.local:5173,http://monitoramento.local:5174,http://monitoramento.local:5175
CSRF_TRUSTED_ORIGINS=http://10.97.198.186:5173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://monitoramento.local:5173,http://monitoramento.local:5174,http://monitoramento.local:5175
# Obrigatório distinto por ambiente — cookies em localhost não separam por porta.
# MAIN → pplid_main_sessionid / pplid_main_csrftoken (frontend :5173, backend :8000)
# DEV  → pplid_dev_sessionid  / pplid_dev_csrftoken  (frontend :5174, backend :8001)
# HOM  → pplid_hom_sessionid  / pplid_hom_csrftoken  (frontend :5175, backend :8002)
SESSION_COOKIE_NAME=pplid_main_sessionid
CSRF_COOKIE_NAME=pplid_main_csrftoken
PPLID_ENV_PROFILE=main

# Em DEBUG, settings.py também acrescenta monitoramento.local e variações de
# PPLID_FRONTEND_URL (http/https) — necessário ao abrir o portal de outra máquina.

# Uploads persistentes no deploy (opcional; default: backend/media)
# Em MAIN/DEV/HOM use o shared do ambiente, ex.:
# MEDIA_ROOT=C:\PPLID\deploy\MAIN\shared\media

# URL do frontend Vue (login compartilhado; redirect do módulo /falhas/)
# Alinhe com a porta do ambiente (5173 main / 5174 dev / 5175 hom).
PPLID_FRONTEND_URL=http://localhost:5173

# Planilha Falhas Críticas (portal Qualidade + botão Sincronizar Excel)
# Upload alternativo: Planejamento > Importar Falhas (não precisa desta variável)
# Planilha master Falhas Criticas (IDF-Bots / report-falhas-criticas)
# EXCEL_SOURCE_PATH=%USERPROFILE%\OneDrive - EXPERIAN SERVICES CORP\Planejamento - IDF - Bots\report-falhas-criticas\FALHAS_CRITICAS_MANUAL.xlsx

# Pasta do relatório de produtividade HxH (brflow-prod-hxh-bruto).
# Deve ser a mesma pasta onde o bot Produção grava relatorio_produtividade_detalhado_*.xlsx
# (automacoes: DEFAULT_SHAREPOINT_BOTS/brflow-prod-hxh-bruto).
# PRODUTIVIDADE_SOURCE_DIR=C:\Users\...\OneDrive - EXPERIAN SERVICES CORP\Planejamento - IDF - Bases\Bots\brflow-prod-hxh-bruto

# Bot produtividade_case (DocumentDB Case Manager) — carregado também via automacoes/.env
# DOCDB_HOST=
# DOCDB_USER=
# DOCDB_PASSWORD=
# DOCDB_TLS_CA_FILE=C:\scripts\produtividade\global-bundle 6.pem
# DOCDB_DB=case-manager-prod
# DOCDB_COLLECTION=transactions

# Pasta do monitor de eventos HxH tratado (monitor-eventos-tratado).
# Gravada pelo bot Produção após download + tratar_arquivo (mesmo pipeline da rotina).
# (automacoes: DEFAULT_SHAREPOINT_BOTS/monitor-eventos-tratado).
# MONITOR_EVENTOS_SOURCE_DIR=C:\Users\...\OneDrive - EXPERIAN SERVICES CORP\Planejamento - IDF - Bases\Bots\monitor-eventos-tratado
#
# Sync manual:
#   python manage.py sync_monitor_eventos --force

# Pastas bruto da rotina (mesmas de automacoes/app/config/paths.py)
# ROTINA_DETALHADO_BRUTO_DIR=C:\Users\...\Planejamento - IDF - Bases\Bots\brflow-detalhado-bruto
# ROTINA_PROD_BRUTO_DIR=C:\Users\...\Planejamento - IDF - Bases\Bots\brflow-prod-bruto
# ROTINA_MONITOR_TRATADO_DIR=C:\Users\...\Planejamento - IDF - Bases\Bots\brflow-monitor-tratado
# ROTINA_MONITOR_BRUTO_DIR=  # obsoleto — fallback temporário se TRATADO_DIR não estiver definido
# ROTINA_CONFER_BUSCA_TRATADO_DIR=C:\Users\...\Planejamento - IDF - Bases\Bots\confer-buscarpIrregularidade-tratado
# ROTINA_GED_DETALHADO_TRATADO_DIR=C:\Users\...\Planejamento - IDF - Bases\Bots\ged-detalhado-tratado
# ROTINA_GED_IRREGULARIDADE_TRATADO_DIR=C:\Users\...\Planejamento - IDF - Bases\Bots\ged-irregularidade-tratado
#
# Carga histórica (após migrate):
#   python manage.py sync_rotina_bruto --all-types --force
# Após mudanças de schema (ex.: tipos de coluna), rode migrate e o comando acima para repopular.
# Se vários PCs usarem o mesmo PostgreSQL, mantenha a mesma SECRET_KEY (hash de CPF).

# Automações (bots BRFlow) — após pip install -e ../automacoes
# Falhas Críticas também exige: playwright install msedge
# ROBOT_LOGS_DIR=
# ROBOT_CONFIG_DIR=
# PYTHON_BIN=
# ROBOT_HEADLESS=false
# GED (portal Claro — bots GED / irregularidade da rotina)
GED_USER=
GED_PASS=

# Microsoft Teams webhooks (notificações dos robôs)
TEAMS_WEBHOOK_PRODUCAO=
TEAMS_WEBHOOK_ROTINA=
TEAMS_WEBHOOK_ALTERACOES=

# RBAC do portal — perfis atribuídos pela UI (Configurações → Usuários)
ACCESS_ENFORCEMENT=false
ESCALA_FLEX_OPEN_ACCESS=false
ACCESS_AUDIT_LOG=false
# Homolog / Produção:
# ACCESS_ENFORCEMENT=true
# ESCALA_FLEX_OPEN_ACCESS=false
# ACCESS_AUDIT_LOG=true

# Senha inicial do seed_portal_users (usuário troca no primeiro login)
PORTAL_SEED_DEFAULT_PASSWORD=pplid@12345678

# Timeout automático de status após horário de saída da escala (roda na aplicação).
STATUS_TIMEOUT_ENABLED=True
STATUS_TIMEOUT_INTERVAL_MINUTES=5

# Anti-gargalo tabela-monitor (cache LocMem + fila + throttle).
TABELA_MONITOR_CACHE_TTL=120
TABELA_MONITOR_MAX_CONCURRENT=1
TABELA_MONITOR_QUEUE_WAIT_MS=15000
TABELA_MONITOR_BUILD_WAIT_S=60
TABELA_MONITOR_THROTTLE=30/min

# Dashboard Replicação D-1 (cache + fila + reconciliação persistida v2).
REPLICACAO_D1_DASHBOARD_CACHE_TTL=60
REPLICACAO_D1_DASHBOARD_MAX_CONCURRENT=1
REPLICACAO_D1_DASHBOARD_QUEUE_WAIT_MS=15000
REPLICACAO_D1_DASHBOARD_BUILD_WAIT_S=60
REPLICACAO_D1_DASHBOARD_FAST_RECONCILIATION=True

# Anti-gargalo produtividade (pool separado).
PRODUTIVIDADE_CACHE_TTL=120
PRODUTIVIDADE_MAX_CONCURRENT=1
PRODUTIVIDADE_QUEUE_WAIT_MS=15000
PRODUTIVIDADE_BUILD_WAIT_S=60
PRODUTIVIDADE_THROTTLE=30/min

# Reset diário de status às 05:30 (horário local) — zera status para novo dia operacional.
DAILY_STATUS_RESET_ENABLED=True
DAILY_STATUS_RESET_HOUR=5
DAILY_STATUS_RESET_MINUTE=30

# Jira Server/DC — formalização Suporte Claro (REST).
# Só a URL é global. Username = Agent.user_lan_id; token = Agent.jira_api_token (por usuário).
# Requer VPN corporativa: sem VPN o gateway SSO devolve 302 e a criação falha.
# JIRA_BASE_URL=https://agile.experian.com
# JIRA_AUTH_MODE=bearer
# JIRA_API_TOKEN=  # opcional: só para manage.py jira_createmeta --token=...
# JIRA_PROXY_URL=  # proxy corporativo explícito; vazio = conexão direta
# JIRA_TRUST_ENV_PROXY=false  # opt-in para HTTP(S)_PROXY do processo
# JIRA_DEMANDAS_SYNC_OVERLAP_MINUTES=10
# JIRA_DEMANDAS_SYNC_STALE_SECONDS=120
# JIRA_PROFILE_PLANEJAMENTO_PROJECT_KEY=PPLID
# JIRA_PROFILE_PLANEJAMENTO_ISSUETYPE=Task
# JIRA_PROFILE_PROCESSOS_PROJECT_KEY=ANTIFRAUDE
# JIRA_PROFILE_PROCESSOS_COMPONENT=Suporte N1 Claro
# JIRA_CATEGORY_FIELD_ID=customfield_37898

# Comentários de andamento no portal (interno / formalizar externo).
SUPORTE_CLARO_COMENTARIOS_ETAPA=true

# Cache compartilhado recomendado para producao/homologacao.
# CACHE_URL=redis://localhost:6379/1
QUALIDADE_OPERACIONAL_CACHE_TTL=180
QUALIDADE_OPERACIONAL_MAX_CONCURRENT=2
QUALIDADE_OPERACIONAL_QUEUE_WAIT_MS=15000
QUALIDADE_OPERACIONAL_BUILD_WAIT_S=120
QUALIDADE_OPERACIONAL_THROTTLE=120/min
# Fonte EO (Intranet × TSV). Legado antes do corte; Intranet a partir dele.
# QUALIDADE_SOURCE_MODE=legacy|hybrid|intranet
# Um corte posterior oculta protocolos Intranet anteriores, como 53044688 (05/08/2026).
QUALIDADE_SOURCE_MODE=hybrid
QUALIDADE_INTRANET_SOURCE_ENABLED=true
QUALIDADE_PROJECTION_ASYNC_ENABLED=true
QUALIDADE_PROJECTION_MAX_ATTEMPTS=3
QUALIDADE_INTRANET_CUTOVER_DATE=2026-08-01
# Override administrativo para importar TSV em competência coberta pela Intranet
QUALIDADE_INTRANET_TSV_OVERRIDE=false

# Quality Overview (Indicadores): auditados/falhas/contestação da EO; suplemento só NA/Treinamentos.
# DEV/HOM: true. MAIN: habilitar após validar carga EO no ambiente.
BRB_REPORT_USE_EO_DB=true
