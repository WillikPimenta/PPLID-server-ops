# Credenciais Okta / BRFlow (injetadas pela UI Flask em runtime)
NIVEL_USER=
NIVEL_PASS=
MONITOR_USER=
MONITOR_PASS=
OKTA_USER=
OKTA_PASS=

# GED (portal Claro — obrigatório para bot GED e task irregularidade da rotina)
GED_USER=
GED_PASS=

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
FLASK_DEBUG=false

# Microsoft Teams webhooks (obrigatório para notificações; copie de .env.example para .env)
TEAMS_WEBHOOK_PRODUCAO=
TEAMS_WEBHOOK_ROTINA=
TEAMS_WEBHOOK_ALTERACOES=

# Operação
PYTHON_BIN=
ROBOT_LOGS_DIR=
ROBOT_CONFIG_DIR=
# Padrão: %USERPROFILE%\OneDrive - EXPERIAN SERVICES CORP\Planejamento - IDF - Bases\Bots\config
ROBOT_HEADLESS=
ROBOT_OUTPUT_DIR=
ROBOT_MAX_WORKERS=

# Bot tray_ui — vigilância de sync infinito do OneDrive (modo tray_ui)
# ONEDRIVE_UI_SYNC_STUCK_POLL_SECONDS=5
# ONEDRIVE_UI_SYNC_STUCK_WINDOW_SECONDS=180
# ONEDRIVE_UI_SYNC_RESTART_COOLDOWN_SECONDS=1800
# ONEDRIVE_UI_SYNC_RESTART_WAIT_SECONDS=15
# ONEDRIVE_SIMULATE_RESTART=1
# Bot tray_ui — bandeja OneDrive + Cisco (ícones da instalação)
# TRAY_SCAN_REGION=55,92,45,8
# TRAY_ICON_TARGET_HEIGHT=48
# TRAY_MATCH_SCALES=0.5,0.75,1.0,1.25,1.5
# CISCO_UI_RES_DIR=

# Bot produtividade_case — DocumentDB Case Manager (sem Okta; credenciais só via .env)
DOCDB_HOST=
DOCDB_PORT=27017
DOCDB_USER=
DOCDB_PASSWORD=
DOCDB_AUTH_SOURCE=admin
DOCDB_TLS_CA_FILE=
# Ex.: C:\scripts\produtividade\global-bundle 6.pem  (fora do repositório)
DOCDB_DB=case-manager-prod
DOCDB_COLLECTION=transactions
# PRODUTIVIDADE_CASE_TEMP_DIR=C:\relatorios_temp
# PRODUTIVIDADE_CASE_REPORTS_ROOT=%USERPROFILE%\EXPERIAN SERVICES CORP\IDF Docs - Relatórios

# Deprecated — instalação externa legada de robôs
SERASA_ROBOS_SRC=
