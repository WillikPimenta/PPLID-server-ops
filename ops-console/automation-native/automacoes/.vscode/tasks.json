{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web: iniciar em background",
      "type": "shell",
      "command": "python web_background.py start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Web: parar background",
      "type": "shell",
      "command": "python web_background.py stop",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
